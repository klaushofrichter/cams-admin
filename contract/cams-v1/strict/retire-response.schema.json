{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/cams-v1/strict/retire-response.schema.json",
  "title": "POST /cams/v1/tokens/:tokenId/retire 200 answer",
  "type": "object",
  "properties": {
    "tokenId": {
      "type": "string",
      "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{20}$"
    },
    "state": {
      "const": "retiring"
    },
    "retireAt": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "tokenId",
    "state",
    "retireAt"
  ],
  "additionalProperties": false
}
