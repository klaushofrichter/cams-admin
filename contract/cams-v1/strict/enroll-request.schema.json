{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/cams-v1/strict/enroll-request.schema.json",
  "title": "POST /cams/v1/enroll request",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "code": {
      "type": "string",
      "maxLength": 64
    },
    "publicKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "proof": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "camsVersion": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "v",
    "code",
    "publicKey",
    "proof",
    "camsVersion"
  ],
  "additionalProperties": false
}
