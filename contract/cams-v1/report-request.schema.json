{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/cams-v1/report-request.schema.json",
  "title": "POST /cams/v1/report request",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "mode": {
      "type": "string",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "appliedRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^r:[0-9a-f]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cacheVerifiedAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "lastPullAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{20}$"
          },
          "camsId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 6,
            "minItems": 1
          }
        },
        "required": [
          "accountId",
          "camsId",
          "fields"
        ]
      },
      "maxItems": 200
    },
    "keptOld": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{20}$"
          },
          "camsId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 6,
            "minItems": 1
          }
        },
        "required": [
          "accountId",
          "camsId",
          "fields"
        ]
      },
      "maxItems": 200
    },
    "shadow": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{20}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "differences": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 20
            }
          },
          "required": [
            "accountId",
            "differences",
            "items"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "object",
      "properties": {
        "managed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "legacy": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "managed",
        "pending",
        "legacy"
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "accountId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "code"
        ]
      },
      "maxItems": 50
    }
  },
  "required": [
    "v",
    "mode"
  ]
}
