{
  "name": "cams-admin",
  "version": "0.0.0",
  "private": true,
  "description": "Account and configuration management for the camera fleet: registry, proxy enrollment, live status, audit log.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.mts",
    "check": "tsc --noEmit -p web/tsconfig.json",
    "check:svelte": "npx --yes svelte-check@4.7.6 --workspace web --tsconfig ./tsconfig.json --threshold error",
    "start": "node dist/server/server.js",
    "dev": "tsx --env-file-if-exists=.env server/server.ts",
    "dev:web": "vite --config web/vite.config.mts",
    "dev:session": "tsx scripts/dev-session.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:types": "tsc --noEmit -p tsconfig.check.json",
    "contract:strict": "tsx contract/make-strict.ts",
    "client": "tsx test-client/cli.ts",
    "load": "tsx test-client/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "ajv": "^8.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "pino": "^10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.2",
    "supertest": "^7.3.1",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
