{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "cams's parseCameras rules (cams server/cameraRegistry.ts) as a schema, for the export round trip. Copied by hand; keep in step with cams.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "host",
      "user",
      "password"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "host": {
        "type": "string",
        "minLength": 1
      },
      "user": {
        "type": "string",
        "minLength": 1
      },
      "password": {
        "type": "string",
        "minLength": 1
      },
      "protocol": {
        "enum": [
          "https",
          "http"
        ]
      },
      "tlsServername": {
        "type": "string",
        "minLength": 1
      },
      "webUiUrl": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          }
        ]
      },
      "webUiNote": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "proxy": {
        "type": "object",
        "required": [
          "url",
          "token"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "token": {
            "type": "string",
            "minLength": 32,
            "pattern": "^\\S+$"
          },
          "adminToken": {
            "type": "string",
            "minLength": 32,
            "pattern": "^\\S+$"
          },
          "camera": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "caFingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "tlsServername": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.-]{1,253}$"
          }
        }
      }
    }
  }
}
