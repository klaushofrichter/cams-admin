# Names only: the real .env (mode 600) is gitignored and never printed.
# scripts/create-secrets.sh reads it and builds the cluster Secrets.

# The repo-scoped runner's registration PAT -> Secret runner-pat (key token)
CAMSADMIN_GITHUB_PAT=
# -> repo secret KUBE_SETUP_DEPLOY_TOKEN (the deploy job's kube-setup clone)
GITHUB_KUBE_SETUP_PAT=
# The system administrators (comma-separated) -> Secret cams-admin-oauth
ALLOWED_EMAILS=
# S3 backup (us-east-1, prefix cams-admin/prod/) -> Secret cams-admin-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=

# Not in .env yet (create-secrets.sh names them and refuses without them):
# cams-admin's own Google OAuth client -> Secret cams-admin-oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to https://cams-admin.skylar.technology/auth/callback
GOOGLE_REDIRECT_URI=
# The PEM made by scripts/gen-signing-key.ts -> Secret cams-admin-signing
SIGNING_KEY_PEM_FILE=
# The kubectl context of the cluster
KUBE_CONTEXT=

# For running the app locally only (npm run dev), never in the Secrets:
# PUBLIC_URL=http://localhost:8090
# SERVER_SIGNING_KEY_FILE=
